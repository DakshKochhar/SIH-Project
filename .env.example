# Copy to .env and adjust for your environment. Never commit the real .env.

# --- App ---
ENVIRONMENT=development
DEBUG=true

# --- Database (PostgreSQL/PostGIS in production; see docker-compose.yml) ---
DATABASE_URL=postgresql+psycopg2://nammaflood:nammaflood@localhost:5432/nammaflood
SQL_ECHO=false

# --- Redis / background jobs ---
REDIS_URL=redis://localhost:6379/0
USE_CELERY=false
UPDATE_INTERVAL_SECONDS=300

# --- Auth ---
SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
ACCESS_TOKEN_EXPIRE_MINUTES=120
CORS_ORIGINS=["*"]

# --- Demo mode ---
DEMO_MODE=true
DEMO_RANDOM_SEED=26085

# --- Data providers: "demo" or the real provider name ---
RAINFALL_PROVIDER=demo
DRAINAGE_PROVIDER=demo
TERRAIN_PROVIDER=demo
LANDCOVER_PROVIDER=demo

# --- Real provider credentials (only needed once a *_PROVIDER above is switched off "demo") ---
IMD_API_KEY=
KSNDMC_API_KEY=
BHUVAN_API_KEY=
